# Copy to .env and set required values:
#   cp .env.example .env

# Required — KasmVNC login credentials.
# Compose (and scripts/up.sh) refuse to start while the password is empty.
CODE_BOX_USER=admin
CODE_BOX_PASSWORD=

# Optional — local-only host edge for KasmVNC. Set CODE_BOX_BIND_ADDRESS=0.0.0.0
# only for a trusted LAN or an HTTPS reverse proxy; it exposes plain HTTP.
# CODE_BOX_BIND_ADDRESS=127.0.0.1
# CODE_BOX_PORT=3000

# Optional — LinuxServer user mapping (match your host UID/GID)
# PUID=1000
# PGID=1000

# Optional — desktop container resources
# CODE_BOX_MEMORY_LIMIT=16G
# CODE_BOX_CPUS=8.0
# CODE_BOX_SHM_SIZE=1gb
# CODE_BOX_PIDS_LIMIT=4096

# Optional — bounded container logs (Docker local logging driver)
# CONTAINER_LOG_MAX_SIZE=10m
# CONTAINER_LOG_MAX_FILE=3

# Optional — sandbox-dind memory (when using Sysbox sibling; see docs/sandbox-docker.md)
# SANDBOX_DIND_MEMORY_LIMIT=8G
# SANDBOX_DIND_CPUS=4.0
# SANDBOX_DIND_PIDS_LIMIT=4096

# Optional — Ollama sibling (see docs/ollama.md)
# Default compose does not enable this; use docker-compose.ollama.yaml
# (add docker-compose.ollama.gpu.yaml on NVIDIA hosts).
# To include overlays in a plain `docker compose up` (same project — required
# for code-box to reach http://ollama:11434), set COMPOSE_FILE, for example:
# COMPOSE_FILE=docker-compose.yaml:docker-compose.sandbox.yaml:docker-compose.ollama.yaml:docker-compose.ollama.gpu.yaml
# OLLAMA_VERSION=0.32.14
# OLLAMA_DIGEST=sha256:9d30908e41144b1f1da89b9d8e33c07e4aeb43ff41a8660241b1686e2cc330ad
# OLLAMA_HOST_PORT=11434
# OLLAMA_MEMORY_LIMIT=8G
# OLLAMA_CPUS=4.0
# OLLAMA_PIDS_LIMIT=1024
# OLLAMA_PROXY_MEMORY_LIMIT=128M
# OLLAMA_PROXY_CPUS=0.25
# OLLAMA_PROXY_PIDS_LIMIT=128
# If host Ollama already binds 11434, pick a free loopback port:
# OLLAMA_HOST_PORT=11435

# Optional — image build pins
# CURSOR_VERSION=3.14
# DIND_VERSION=29.8.1-dind
# DIND_DIGEST=sha256:3f3c01aaaebf7cce837356b688b7c059a4749f10bd7660dec7c58fc454a283f0
# NODE_VERSION=24
# NVM_VERSION=0.40.6
# CLAUDE_CODE_VERSION=2.1.220
# OPENCODE_VERSION=1.18.18
# PLAYWRIGHT_MCP_VERSION=0.0.79
# GITHUB_MCP_VERSION=1.11.0
# FETCH_MCP_VERSION=2026.8.18

# Optional — isolated Docker via Sysbox sibling (see docs/sandbox-docker.md)
# Default compose does not enable this. One command (checks sysbox-runc,
# generates certs, starts sandbox-dind then code-box):
#   scripts/up.sh --sandbox
