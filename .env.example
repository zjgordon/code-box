# Copy to .env and set required values:
#   cp .env.example .env

# Required — KasmVNC login credentials
CODE_BOX_USER=admin
CODE_BOX_PASSWORD=changeme

# Optional — host port mapped to container 3000
# CODE_BOX_PORT=3000

# Optional — LinuxServer user mapping (match your host UID/GID)
# PUID=1000
# PGID=1000

# Optional — desktop container resources
# CODE_BOX_MEMORY_LIMIT=16G
# CODE_BOX_CPUS=8.0
# CODE_BOX_SHM_SIZE=1gb

# Optional — sandbox-dind memory (when using Sysbox sibling; see docs/sandbox-docker.md)
# SANDBOX_DIND_MEMORY_LIMIT=8G

# Optional — Ollama sibling (see docs/ollama.md)
# Default compose does not enable this; use docker-compose.ollama.yaml
# (add docker-compose.ollama.gpu.yaml on NVIDIA hosts).
# OLLAMA_VERSION=0.32.14
# OLLAMA_HOST_PORT=11434
# OLLAMA_MEMORY_LIMIT=8G
# If host Ollama already binds 11434, pick a free loopback port:
# OLLAMA_HOST_PORT=11435

# Optional — image build pins
# CURSOR_VERSION=3.14
# NODE_VERSION=24
# NVM_VERSION=0.40.6
# CLAUDE_CODE_VERSION=2.1.220
# OPENCODE_VERSION=1.18.18
# PLAYWRIGHT_MCP_VERSION=0.0.79

# Optional — isolated Docker via Sysbox sibling (see docs/sandbox-docker.md)
# Default compose does not enable this; use docker-compose.sandbox.yaml after
# generating certs and starting sandbox-dind.
