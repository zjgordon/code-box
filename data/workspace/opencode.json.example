{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["/usr/local/bin/playwright-mcp"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["/usr/local/bin/github-mcp"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["/usr/local/bin/fetch-mcp"],
      "enabled": true
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (code-box)",
      "options": {
        "baseURL": "http://ollama:11434/v1"
      },
      "models": {
        "MODEL_TAG": {
          "name": "Display name"
        }
      }
    }
  }
}
